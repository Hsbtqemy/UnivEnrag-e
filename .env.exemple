# Copier en `.env` (jamais dans git), puis remplir.

# Nom de domaine du site, déjà pointé (DNS) vers ce serveur.
SITE_DOMAINE=collectif.exemple.org

# Clé secrète Django : 50 caractères aléatoires, à ne jamais changer ni divulguer.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Nombre de processus gunicorn (3 suffisent pour 300 personnes).
GUNICORN_WORKERS=3
