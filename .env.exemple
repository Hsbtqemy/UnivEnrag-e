# Copier en `.env` (jamais dans git), puis remplir.

# Nom de domaine du site, déjà pointé (DNS) vers ce serveur. Sans domaine, sslip.io en
# tient lieu : univ-enragee.<ip-avec-des-tirets>.sslip.io résout vers cette IP.
SITE_DOMAINE=univ-enragee.edito-revue.fr

# Serveur partagé (Nginx de l'hôte déjà sur 80/443) : décommenter ces deux lignes.
# COMPOSE_FILE=compose.yaml:compose.derriere-proxy.yaml
# PORT_LOCAL=8081

# Clé secrète Django : 50 caractères aléatoires, à ne jamais changer ni divulguer.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Nombre de processus gunicorn (3 suffisent pour 300 personnes).
GUNICORN_WORKERS=3
