# Caddy devant le site : HTTPS automatique, fichiers statiques, relais vers gunicorn.
# Pas de directive `log` : Caddy ne tient aucun journal d'accès, donc aucune adresse IP.
{
	servers {
		protocols h1 h2 h3
	}
}

{$SITE_DOMAINE} {
	encode zstd gzip
	header -Server

	request_body {
		max_size 25MB
	}

	handle_path /static/* {
		root * /srv/static
		# Noms versionnés par Django (apps/core/storage.py) : cache d'un an.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8000
	}
}
