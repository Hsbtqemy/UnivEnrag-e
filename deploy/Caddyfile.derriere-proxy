# Variante quand le serveur a déjà un relais HTTPS (un autre Caddy, Nginx…) qui gère les
# certificats. Celui-ci écoute en HTTP simple ; le relais amont doit transmettre
# X-Forwarded-Proto et X-Forwarded-For. Idée reprise de BD_ditor (deploy/Caddyfile.derriere-proxy).
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

http://{$SITE_DOMAINE} {
	encode zstd gzip
	header -Server

	request_body {
		max_size 25MB
	}

	handle_path /static/* {
		root * /srv/static
		# Noms versionnés par Django (apps/core/storage.py) : cache d'un an.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8000 {
			# Le relais amont a déjà terminé le HTTPS : on le dit à Django.
			header_up X-Forwarded-Proto https
		}
	}
}
